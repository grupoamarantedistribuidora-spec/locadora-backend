# Copie este arquivo pra ".env" (local) ou cadastre as mesmas chaves como
# "Environment Variables" no serviço do Render. NUNCA commite o ".env" de verdade
# num repositório público — só o .env.example (sem valores reais) deve ir pro git.

# Libera esse endereço a chamar o backend (coloque a URL real do seu site, ex.:
# https://seu-site.netlify.app). Use "*" só pra testar, nunca em produção de verdade.
FRONTEND_ORIGIN=*

# --- Cora (boletos e PIX) ---
# Gerados no painel do Cora (developers.cora.com.br) ao criar uma aplicação.
CORA_CLIENT_ID=
CORA_CERT_PATH=./certs/cora-certificate.pem
CORA_KEY_PATH=./certs/cora-private-key.key
CORA_API_BASE=https://matls-clients.api.cora.com.br

# --- Infosimples (SPC/Serasa, pontos de CNH, restrições do veículo, multas) ---
# Token gerado no painel da Infosimples (api.infosimples.com).
INFOSIMPLES_TOKEN=

# --- ZapSign (assinatura eletrônica de contratos) ---
# Token gerado no painel da ZapSign (app.zapsign.com.br → Integrações → API).
ZAPSIGN_API_TOKEN=
ZAPSIGN_API_BASE=https://api.zapsign.com.br/api/v1

# --- Provedor fiscal (emissão de NFC-e/NF-e — frente de caixa) ---
# Token gerado no painel do provedor fiscal que você contratar (ex.: Focus NFe, eNotas,
# PlugNotas). ANTES de preencher isso, você precisa ter, no provedor escolhido: seu CNPJ
# cadastrado, um certificado digital A1 (.pfx) enviado pra eles, e o ambiente de produção
# liberado — isso é exigência da Receita/SEFAZ, o token sozinho não emite nota nenhuma.
FISCAL_API_TOKEN=
FISCAL_API_BASE=https://api.focusnfe.com.br/v2
